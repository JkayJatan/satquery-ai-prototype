# Example Streamlit secrets configuration for SatQuery AI
# Copy this content into .streamlit/secrets.toml or configure in Streamlit Community Cloud Settings

# Hosted Vision-Language Model API URL
# Supports OpenAI-compatible endpoints (e.g., GPT-4o, Claude via proxy, or vLLM/Ollama hosted endpoint)
VLM_API_URL = "https://api.openai.com/v1/chat/completions"

# Your API Key for the vision model service
VLM_API_KEY = "your-api-key-here"

# Model identifier
VLM_MODEL = "gpt-4o-mini"
